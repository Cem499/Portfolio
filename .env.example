# Public client-side keys (they end up in the browser bundle, like before in the HTML).
# Copy to .env for local builds; set the same variables in the Render dashboard.
VITE_EMAILJS_PUBLIC_KEY=_U_phGxH8KcaJXxfq
VITE_EMAILJS_SERVICE_ID=service_qlylu4x
VITE_EMAILJS_TEMPLATE_ID=template_5mci63d
VITE_TURNSTILE_SITEKEY=0x4AAAAAACkZoLXteSgJ1jzs

# Contact worker (worker/README.md). Leave empty to send straight from the browser through EmailJS;
# set to the worker's address to have the Turnstile token checked on the server first.
VITE_CONTACT_ENDPOINT=

# Google PageSpeed Insights API (Website-Check unter /website-check/). Key in der Google Cloud Console
# auf HTTP-Referrer https://www.sin-digital.com/* einschränken.
VITE_PSI_API_KEY=
